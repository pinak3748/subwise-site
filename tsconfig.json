{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Allow @ts-ignore and @ts-expect-error comments
    // TypeScript supports these directives by default
    // You can use @ts-ignore or @ts-expect-error to suppress type errors when needed
    //  Path Alias
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "global.d.ts", "./auto-imports.d.ts"],
  "exclude": ["node_modules", "dist"],

  "references": [{ "path": "./tsconfig.node.json" }]
}
